# Hostinger MySQL Database Configuration
DB_CONNECTION=mysql
DB_HOST=your-hostinger-mysql-host.hostinger.com
DB_PORT=3306
DB_DATABASE=u123456789_dbname
DB_USERNAME=u123456789_dbuser
DB_PASSWORD=your_secure_db_password

# Optional: Set to true if SSL connection is required by MySQL server
DB_SSL=false

# Allowed CORS Origin (default: * for mobile apps / development)
CORS_ORIGIN=*

# Server Port (for local testing with 'npm run dev')
PORT=3000
